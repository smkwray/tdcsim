{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdcsim.local/schemas/cbo-scenario-v1.schema.json",
  "title": "TDCSIM CBO scenario overlay v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "baseline",
    "provenance",
    "coupling",
    "overrides",
    "output"
  ],
  "properties": {
    "schema_version": {
      "const": "tdcsim_cbo_scenario_v1"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "title": {
      "type": "string",
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "maxLength": 4096
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "package_sha256",
        "manifest_sha256",
        "release_attestation_sha256"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "package_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "release_attestation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "allow_compatible_baseline": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label"
      ],
      "properties": {
        "kind": {
          "enum": [
            "tdcsim_transform_of_cbo_baseline",
            "external_source_assumption",
            "user_stress_assumption"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "prepared_by": {
          "type": "string",
          "maxLength": 256
        },
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "external_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalSource"
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frequency": {
          "const": "daily"
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "open04_campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "role",
        "funding_closure_mode"
      ],
      "properties": {
        "contract_id": {
          "const": "open04_paired_tradeoff_v1"
        },
        "role": {
          "enum": [
            "baseline",
            "candidate_a",
            "candidate_b"
          ]
        },
        "funding_closure_mode": {
          "const": "cbo_debt_reference_plus_tga_floor_financing_v1"
        }
      }
    },
    "coupling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frn_benchmark",
        "tips_real_yield",
        "operating_cash_inflation",
        "primary_deficit_to_debt_target"
      ],
      "properties": {
        "frn_benchmark": {
          "enum": [
            "derive_from_scenario_nominal_curve",
            "independent_explicit_path"
          ]
        },
        "tips_real_yield": {
          "enum": [
            "recompute_from_nominal_and_scenario_inflation",
            "independent_explicit_path"
          ]
        },
        "operating_cash_inflation": {
          "enum": [
            "scenario_cpi",
            "baseline_cpi",
            "independent_explicit_path"
          ]
        },
        "primary_deficit_to_debt_target": {
          "const": "independent_no_plug"
        }
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nominal_yield_curve": {
          "$ref": "#/$defs/nominalCurveOverride"
        },
        "frn_benchmark": {
          "$ref": "#/$defs/frnOverride"
        },
        "inflation_cpi": {
          "$ref": "#/$defs/cpiOverride"
        },
        "tips_real_yield": {
          "$ref": "#/$defs/tipsRealYieldOverride"
        },
        "operating_cash": {
          "$ref": "#/$defs/operatingCashOverride"
        },
        "cash_reconciliation": {
          "$ref": "#/$defs/cashResidualOverride"
        },
        "issuance_mix": {
          "$ref": "#/$defs/issuanceMixOverride"
        },
        "fed_holdings": {
          "$ref": "#/$defs/stockPathOverride"
        },
        "holder_preferences": {
          "$ref": "#/$defs/holderPreferenceOverride"
        },
        "primary_deficit": {
          "$ref": "#/$defs/fiscalPathOverride"
        },
        "debt_target": {
          "$ref": "#/$defs/fiscalPathOverride"
        },
        "fiscal_incidence": {
          "$ref": "#/$defs/fiscalIncidenceOverride"
        },
        "net_interest_comparator": {
          "$ref": "#/$defs/netInterestComparator"
        },
        "mmf_deposit_pass_through": {
          "$ref": "#/$defs/mmfDepositPassThroughOverride"
        },
        "mmf_added_position": {
          "type": "object",
          "additionalProperties": false,
          "required": ["settlement_route", "opening_on_rrp_bil"],
          "properties": {
            "settlement_route": {"enum": ["covered_deposit_settled", "on_rrp_mmf"]},
            "opening_on_rrp_bil": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "holder_position_target": {
          "oneOf": [
            {"$ref": "#/$defs/holderPositionTargetOverride"},
            {"$ref": "#/$defs/holderBillTargetOverride"}
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "compression"
      ],
      "properties": {
        "profile": {
          "enum": [
            "summary",
            "compact",
            "audit"
          ]
        },
        "compression": {
          "enum": [
            "gzip",
            "none"
          ]
        },
        "catalog_sqlite": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "funding_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "cbo_operating_cash_target_financing_v1",
            "cbo_public_debt_target",
            "cbo_debt_reference_plus_tga_floor_financing_v1"
          ]
        }
      }
    }
  },
  "$defs": {
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "sha256"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_type": {
          "type": "string",
          "enum": [
            "text/csv"
          ]
        }
      }
    },
    "externalSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "locator",
        "retrieved_at",
        "sha256"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "keyRateShock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenor_years",
        "shock_bp"
      ],
      "properties": {
        "tenor_years": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shock_bp": {
          "type": "number",
          "minimum": -5000,
          "maximum": 5000
        }
      }
    },
    "nominalCurveOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "parallel_bp",
            "key_rate_bp",
            "evaluated_additive_key_rate_bp",
            "full_surface_file"
          ]
        },
        "shock_bp": {
          "type": "number",
          "minimum": -5000,
          "maximum": 5000
        },
        "shocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/keyRateShock"
          }
        },
        "interpolation": {
          "enum": [
            "log_tenor_linear",
            "pchip_log_tenor"
          ]
        },
        "application": {
          "const": "post_baseline_evaluation"
        },
        "lower_endpoint": {
          "const": "zero_at_or_below_first_key"
        },
        "upper_endpoint": {
          "const": "flat_at_or_above_last_key"
        },
        "time_profile": {
          "const": "constant_across_curve_dates"
        },
        "compounding": {
          "const": "none"
        },
        "file": {
          "$ref": "#/$defs/fileRef"
        }
      },
      "oneOf": [
        {
          "properties": {
            "mode": {
              "const": "parallel_bp"
            }
          },
          "required": [
            "mode",
            "shock_bp"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "file"
                ]
              },
              {
                "required": [
                  "interpolation"
                ]
              },
              {
                "required": [
                  "shocks"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "mode": {
              "const": "key_rate_bp"
            }
          },
          "required": [
            "mode",
            "shocks"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "file"
                ]
              },
              {
                "required": [
                  "shock_bp"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "mode": {
              "const": "evaluated_additive_key_rate_bp"
            }
          },
          "required": [
            "mode",
            "application",
            "interpolation",
            "lower_endpoint",
            "upper_endpoint",
            "time_profile",
            "compounding",
            "shocks"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "file"
                ]
              },
              {
                "required": [
                  "shock_bp"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "mode": {
              "const": "full_surface_file"
            }
          },
          "required": [
            "mode",
            "file"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "interpolation"
                ]
              },
              {
                "required": [
                  "shock_bp"
                ]
              },
              {
                "required": [
                  "shocks"
                ]
              }
            ]
          }
        }
      ]
    },
    "frnOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "linked_to_nominal_curve",
            "parallel_bp",
            "absolute_path_file"
          ]
        },
        "spread_bp": {
          "type": "number",
          "minimum": -5000,
          "maximum": 5000
        },
        "shock_bp": {
          "type": "number",
          "minimum": -5000,
          "maximum": 5000
        },
        "file": {
          "$ref": "#/$defs/fileRef"
        }
      },
      "oneOf": [
        {
          "properties": {
            "mode": {
              "const": "linked_to_nominal_curve"
            }
          },
          "required": [
            "mode"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "file"
                ]
              },
              {
                "required": [
                  "shock_bp"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "mode": {
              "const": "parallel_bp"
            }
          },
          "required": [
            "mode",
            "shock_bp"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "file"
                ]
              },
              {
                "required": [
                  "spread_bp"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "mode": {
              "const": "absolute_path_file"
            }
          },
          "required": [
            "mode",
            "file"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "shock_bp"
                ]
              },
              {
                "required": [
                  "spread_bp"
                ]
              }
            ]
          }
        }
      ]
    },
    "cpiOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "annualized_inflation_shift_bp",
            "cpi_level_scale",
            "monthly_path_file"
          ]
        },
        "shock_bp": {
          "type": "number",
          "minimum": -5000,
          "maximum": 5000
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "file": {
          "$ref": "#/$defs/fileRef"
        },
        "terminal_rule": {
          "enum": [
            "baseline_terminal_growth",
            "carry_last_scenario_growth"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "mode": {
              "const": "annualized_inflation_shift_bp"
            }
          },
          "required": [
            "mode",
            "shock_bp"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "file"
                ]
              },
              {
                "required": [
                  "scale"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "mode": {
              "const": "cpi_level_scale"
            }
          },
          "required": [
            "mode",
            "scale"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "file"
                ]
              },
              {
                "required": [
                  "shock_bp"
                ]
              },
              {
                "required": [
                  "terminal_rule"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "mode": {
              "const": "monthly_path_file"
            }
          },
          "required": [
            "mode",
            "file"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "scale"
                ]
              },
              {
                "required": [
                  "shock_bp"
                ]
              },
              {
                "required": [
                  "terminal_rule"
                ]
              }
            ]
          }
        }
      ]
    },
    "tipsRealYieldOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "linked_recompute",
            "parallel_bp",
            "key_rate_bp",
            "absolute_path_file"
          ]
        },
        "additional_parallel_bp": {
          "type": "number",
          "minimum": -5000,
          "maximum": 5000
        },
        "shock_bp": {
          "type": "number",
          "minimum": -5000,
          "maximum": 5000
        },
        "shocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/keyRateShock"
          }
        },
        "interpolation": {
          "enum": [
            "log_tenor_linear",
            "pchip_log_tenor"
          ]
        },
        "file": {
          "$ref": "#/$defs/fileRef"
        }
      },
      "oneOf": [
        {
          "properties": {
            "mode": {
              "const": "linked_recompute"
            }
          },
          "required": [
            "mode"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "file"
                ]
              },
              {
                "required": [
                  "interpolation"
                ]
              },
              {
                "required": [
                  "shock_bp"
                ]
              },
              {
                "required": [
                  "shocks"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "mode": {
              "const": "parallel_bp"
            }
          },
          "required": [
            "mode",
            "shock_bp"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "additional_parallel_bp"
                ]
              },
              {
                "required": [
                  "file"
                ]
              },
              {
                "required": [
                  "interpolation"
                ]
              },
              {
                "required": [
                  "shocks"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "mode": {
              "const": "key_rate_bp"
            }
          },
          "required": [
            "mode",
            "shocks"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "additional_parallel_bp"
                ]
              },
              {
                "required": [
                  "file"
                ]
              },
              {
                "required": [
                  "shock_bp"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "mode": {
              "const": "absolute_path_file"
            }
          },
          "required": [
            "mode",
            "file"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "additional_parallel_bp"
                ]
              },
              {
                "required": [
                  "interpolation"
                ]
              },
              {
                "required": [
                  "shock_bp"
                ]
              },
              {
                "required": [
                  "shocks"
                ]
              }
            ]
          }
        }
      ]
    },
    "operatingCashOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "constant_real",
            "constant_nominal",
            "inflation_beta",
            "scale_baseline",
            "aggregate_path_file",
            "component_path_file"
          ]
        },
        "scale": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "beta": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "file": {
          "$ref": "#/$defs/fileRef"
        },
        "tga_settlement_component": {
          "type": "boolean",
          "const": true
        },
        "toc_components_are_exogenous_diagnostics": {
          "type": "boolean",
          "const": true
        }
      },
      "oneOf": [
        {
          "properties": {
            "mode": {
              "const": "constant_real"
            }
          },
          "required": [
            "mode"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "file"
                ]
              },
              {
                "required": [
                  "scale"
                ]
              },
              {
                "required": [
                  "tga_settlement_component"
                ]
              },
              {
                "required": [
                  "toc_components_are_exogenous_diagnostics"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "mode": {
              "const": "constant_nominal"
            }
          },
          "required": [
            "mode"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "file"
                ]
              },
              {
                "required": [
                  "scale"
                ]
              },
              {
                "required": [
                  "tga_settlement_component"
                ]
              },
              {
                "required": [
                  "toc_components_are_exogenous_diagnostics"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "mode": {
              "const": "inflation_beta"
            }
          },
          "required": [
            "mode",
            "beta"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "file"
                ]
              },
              {
                "required": [
                  "scale"
                ]
              },
              {
                "required": [
                  "tga_settlement_component"
                ]
              },
              {
                "required": [
                  "toc_components_are_exogenous_diagnostics"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "mode": {
              "const": "scale_baseline"
            }
          },
          "required": [
            "mode",
            "scale"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "file"
                ]
              },
              {
                "required": [
                  "tga_settlement_component"
                ]
              },
              {
                "required": [
                  "toc_components_are_exogenous_diagnostics"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "mode": {
              "const": "aggregate_path_file"
            }
          },
          "required": [
            "mode",
            "file"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "scale"
                ]
              },
              {
                "required": [
                  "tga_settlement_component"
                ]
              },
              {
                "required": [
                  "toc_components_are_exogenous_diagnostics"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "mode": {
              "const": "component_path_file"
            }
          },
          "required": [
            "mode",
            "file"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "scale"
                ]
              }
            ]
          }
        }
      ]
    },
    "cashResidualOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "zero",
            "track_operating_cash_target",
